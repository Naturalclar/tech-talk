{
  "name": "mdx-slide",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "jesse.katsumata@gmail.com",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "prepare": "tsc",
    "build": "node ./bin/generate-slides.js src/talks",
    "build:assets": "cpx ./src/talks/assets/**/* ./dist/assets",
    "build:css": "tailwindcss -i ./src/index.css -o ./dist/index.css --minify",
    "build:index": "node ./bin/generate-index.js",
    "build:meta": "node ./bin/generate-meta.js",
    "build:oembed": "node ./bin/generate-oembed.js",
    "build:screenshot": "node ./bin/generate-screenshot.js",
    "clean": "rm -rf dist",
    "lint": "oxlint",
    "new": "scaffdog generate -o .",
    "start": "node ./bin/start.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nkzw/remdx": "^20.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-monaco-editor": "^0.59.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@nkzw/vite-plugin-remdx": "^20.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "cpx2": "^9.0.0",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.78.0",
    "playwright": "^1.56.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "scaffdog": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "pnpm": {
    "overrides": {
      "path-parse": ">=1.0.7",
      "hosted-git-info@2": ">=2.8.9",
      "ini@1": ">=1.3.6"
    }
  }
}
