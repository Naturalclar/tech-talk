{
  "name": "mdx-slide",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "jesse.katsumata@gmail.com",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node ./scripts/generate-slides.ts src/talks",
    "build:assets": "cpx ./src/talks/assets/**/* ./dist/assets",
    "build:css": "tailwindcss -i ./src/index.css -o ./dist/index.css --minify",
    "build:index": "node ./scripts/generate-index.ts",
    "build:meta": "node ./scripts/generate-meta.ts",
    "build:oembed": "node ./scripts/generate-oembed.ts",
    "build:screenshot": "node ./scripts/generate-screenshot.ts",
    "clean": "rm -rf dist",
    "lint": "oxlint",
    "new": "scaffdog generate -o .",
    "start": "node ./scripts/start.ts",
    "test": "node ./scripts/og-image.test.ts",
    "typecheck": "tsc && tsc -p tsconfig.src.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nkzw/remdx": "^20.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-monaco-editor": "^0.59.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@nkzw/vite-plugin-remdx": "^20.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "cpx2": "^9.0.0",
    "oxlint": "^1.80.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "scaffdog": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "pnpm": {
    "overrides": {
      "ini@1": ">=1.3.6",
      "minimist": ">=1.2.6"
    }
  }
}
