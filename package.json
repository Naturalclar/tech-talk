{
  "name": "mdx-slide",
  "version": "1.0.0",
  "license": "MIT",
  "author": "jesse.katsumata@gmail.com",
  "main": "index.js",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer"
    ]
  },
  "scripts": {
    "prepare": "tsc",
    "build": "node ./bin/generate-slides.js src/talks",
    "build:assets": "cpx ./src/talks/assets/**/* ./dist/assets",
    "build:index": "ts-node ./scripts/generate-index.ts",
    "build:mdx": "mdx-deck build",
    "build:oembed": "ts-node ./scripts/generate-oembed.ts",
    "build:screenshot": "mdx-deck screenshot --no-sandbox",
    "clean": "rm -rf dist",
    "lint": "eslint ./src --ext .ts,.tsx",
    "new": "scaffdog generate",
    "pdf": "mdx-deck pdf",
    "start": "mdx-deck src/talks/create-touchbar-app-with-js/index.mdx"
  },
  "dependencies": {
    "@mdx-js/tag": "^0.15.6",
    "mdx-code": "^1.1.3",
    "mdx-deck": "^1.8.2",
    "monaco-editor-webpack-plugin": "^1.7.0",
    "react": "^16.8.2",
    "react-dom": "^16.8.2",
    "react-monaco-editor": "^0.25.1",
    "react-syntax-highlighter": "^8.1.0",
    "react-native-web": "^0.11.4",
    "styled-components": "^4.1.3"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.3.3",
    "@types/node": "^11.12.0",
    "@babel/preset-react": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^1.9.0",
    "@typescript-eslint/parser": "^1.9.0",
    "babel-loader": "^8.0.0",
    "cpx": "^1.5.0",
    "css-loader": "^2.1.1",
    "eslint": "^5.16.0",
    "eslint-config-prettier": "^4.1.0",
    "eslint-plugin-prettier": "^3.0.1",
    "eslint-plugin-react": "^7.12.4",
    "file-loader": "^3.0.1",
    "mdx-deck-code-surfer": "^0.5.5",
    "npm-run-all": "^4.1.5",
    "prettier": "^1.17.0",
    "raw-loader": "^1.0.0",
    "rimraf": "^2.6.3",
    "scaffdog": "^0.0.7",
    "style-loader": "^0.23.1",
    "ts-node": "^8.1.0",
    "typescript": "^3.4.5"
  }
}
