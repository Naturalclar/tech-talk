{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    // The screenshot script evaluates code inside the browser, so it needs the
    // DOM types even though nothing here runs in one.
    "lib": ["es2023", "dom"],
    "module": "node18",
    "outDir": "./bin",
    "rootDir": "./scripts",
    "strict": true,
    "target": "es2022",
    "types": ["node"]
  },
  // Only the build scripts are compiled to bin/. The decks and the vite config
  // are handled by vite itself.
  "include": ["./scripts"]
}
