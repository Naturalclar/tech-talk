{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-console": "off"
  },
  "ignorePatterns": ["dist", "src/talks"],
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "react-hooks/rules-of-hooks": "error"
      }
    }
  ]
}
